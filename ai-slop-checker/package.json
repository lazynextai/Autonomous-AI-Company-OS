{
  "name": "@lazynext/ai-slop-checker",
  "version": "1.4.4",
  "description": "Lazynext AI Slop Checker — deterministic scanner for AI writing tells and AI-default visual design tics. Merge of the ideas behind no-ai-slop, stop-slop, impeccable, hallmark and kill-ai-slop.",
  "license": "MIT",
  "private": false,
  "type": "commonjs",
  "main": "src/scanner.js",
  "files": [
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "llms.txt",
    "data/",
    "src/",
    "api/",
    "web/",
    "skill/",
    "docs/",
    "assets/"
  ],
  "exports": {
    ".": "./src/scanner.js",
    "./patterns": "./data/slop-patterns.js",
    "./profiles": "./data/profiles.js",
    "./rules": "./src/rules-loader.js",
    "./rewriter": "./src/rewriter.js",
    "./project-scanner": "./src/project-scanner.js",
    "./project-scanner-browser": "./src/project-scanner-browser.js",
    "./render-checks": "./src/render-checks.js",
    "./collect-render": "./src/collect-render.js",
    "./judge": "./src/judge.js",
    "./api": "./api/server.js",
    "./worker": "./api/worker.js",
    "./agent-surfaces": "./api/agent-surfaces.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "e2e": "node scripts/e2e.js",
    "check": "node scripts/check.js",
    "eval": "node bench/eval.js",
    "eval:json": "node bench/eval.js --json",
    "start": "node api/server.js",
    "scan:cli": "node api/cli.js",
    "gen:assets": "node scripts/generate-embedded-assets.js",
    "live": "node scripts/live-check.js",
    "live:all": "node scripts/live-check.js --hosts checker.lazynext.com,api.lazynext.com,app.lazynext.com,lazynext.com"
  },
  "keywords": [
    "ai-slop",
    "slop-detector",
    "anti-ai",
    "copy-editing",
    "design-lint",
    "lazynext"
  ]
}